{
  "name": "syncspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "dev:all": "npx --yes concurrently --kill-others-on-fail -n \"frontend,api,realtime,worker\" -c \"cyan.bold,green.bold,magenta.bold,yellow.bold\" \"npm run dev\" \"npm run start:dev --prefix backend/api\" \"npm run start:dev --prefix backend/realtime\" \"npm run start:dev --prefix backend/worker\"",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "docker:build": "./scripts/docker-build.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^7.0.3",
    "@tiptap/extension-collaboration": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.11.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
