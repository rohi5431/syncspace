# Template for the NestJS API, realtime gateway, or worker.
# Build from the service directory with SERVICE_NAME set to the package output.
FROM node:25-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
FROM node:25-alpine AS build
RUN corepack enable
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build
FROM node:25-alpine AS runtime
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=app:app /app/dist ./dist
COPY --from=build --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/package.json ./package.json
USER app
ARG SERVICE_ENTRY=dist/main.js
ENV SERVICE_ENTRY=$SERVICE_ENTRY
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:${PORT:-3001}/health/live || exit 1
ENTRYPOINT ["/bin/sh", "-c", "node $SERVICE_ENTRY"]
